# Login credentials (shared by all analysts). Copy this file to .env.local for local dev,
# and set the same variables in Vercel → Settings → Environment Variables for production.

# Username for the login page (default: b24)
AUTH_USERNAME=b24

# Password for the login page. IMPORTANT: if left empty, the panel has NO login.
# Always set a real value in production.
AUTH_PASSWORD=

# Secret used to sign the session cookie. Use a long random string.
# If empty, AUTH_PASSWORD is used as the signing key instead.
AUTH_SECRET=
